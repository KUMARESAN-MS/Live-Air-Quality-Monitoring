# .env.example
# Copy this to .env and fill in your values.
# The app works perfectly without any real API keys (simulation mode is on by default).

# Kafka broker address (only needed if SIMULATION_MODE = False in config/settings.py)
KAFKA_BROKER=localhost:9092

# Optional: OpenWeatherMap API key for real city data
# Free tier at: https://openweathermap.org/api/air-pollution
# OPENWEATHER_API_KEY=your_key_here
